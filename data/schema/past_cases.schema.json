{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/past_cases.json",
  "description": "「過去の事例」ページに載せる、報道等で伝えられた事例（docs/PLAN.md §1.1・付録B）。当サイトが公式発表を確かめた登録ではないので「障害中」とは表示しない。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "service_ids", "name", "period", "cause", "summary", "alternatives_used", "sources"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "service_ids": { "type": "array", "items": { "type": "string" }, "description": "このサイトで扱っているサービスの id（無ければ []）" },
      "name": { "type": "string" },
      "period": { "type": "string" },
      "cause": { "type": "string" },
      "summary": { "type": "string", "description": "自分の言葉で短く" },
      "alternatives_used": { "type": "array", "items": { "type": "string" } },
      "sources": {
        "type": "array",
        "minItems": 1,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "type"],
              "properties": { "url": { "type": "string", "pattern": "^https://" }, "type": { "const": "press" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "type", "service_id"],
              "properties": {
                "url": { "type": "string", "pattern": "^https://" },
                "type": { "const": "official" },
                "service_id": { "type": "string", "description": "service_ids のどれか。URL はそのサービスの official_domains に一致すること" }
              }
            }
          ]
        }
      }
    }
  }
}
