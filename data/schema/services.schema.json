{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/services.json",
  "description": "見張る対象のサービス（docs/PLAN.md §5.1・付録A）。形の説明のための文書で、検査は scripts/validate.mjs が行う。\"unverified\" は「調べられなかった（未確認）」、null は「調べて無かった」。",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "operator", "category", "mostly_unverified", "official_domains", "official_top", "official_notices", "official_x", "phone_desk", "official_alternatives", "general_alternatives", "not_official", "phishing_guide", "monitor", "notes", "verified_at", "verified_by"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "name": { "type": "string", "description": "サービス名。「公式」を単独で使わない" },
      "operator": { "type": "string", "description": "運営会社の正式な名称か \"unverified\"" },
      "category": { "type": "string", "description": "data/categories.json の id" },
      "mostly_unverified": { "type": "boolean", "description": "true のときページは「公式トップへのリンク」と「未確認」だけを出す（付録A の★）" },
      "official_domains": {
        "description": "公式ドメイン。\"bk.mufg.jp\" はそのドメインとサブドメイン、\"secure.okbiz.jp/eki-net/\" はそのホストのそのパスの下だけ（委託先）",
        "oneOf": [{ "const": "unverified" }, { "type": "array", "minItems": 1, "items": { "type": "string" } }]
      },
      "official_top": { "oneOf": [{ "const": "unverified" }, { "$ref": "#/$defs/link" }] },
      "official_notices": { "oneOf": [{ "const": "unverified" }, { "type": "null" }, { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/link" } }] },
      "official_x": {
        "description": "公式 X。画面ではリンクにせず、アカウント名を文字で出す",
        "oneOf": [
          { "const": "unverified" },
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["handle", "note", "source_url"],
            "properties": {
              "handle": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_]{1,15}$", "description": "@ を付けない" },
              "note": { "type": ["string", "null"] },
              "source_url": { "type": ["string", "null"], "description": "アカウントの一覧のページ（handle が null のときは必須）" }
            }
          }
        ]
      },
      "phone_desk": { "enum": ["listed", "none", "unverified"], "description": "listed: 番号を公式ページで確認 / none: 電話窓口は無いと公式で確認 / unverified: 未確認" },
      "official_alternatives": {
        "description": "会社が公表している代わりの手段だけ",
        "oneOf": [
          { "const": "unverified" },
          {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "detail", "url", "phones", "hours"],
              "properties": {
                "label": { "type": "string" },
                "detail": { "type": ["string", "null"] },
                "url": { "type": ["string", "null"], "description": "根拠のページ。電話番号があるときは必須" },
                "phones": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["number", "note"],
                    "properties": {
                      "number": { "type": "string", "pattern": "^(?:0\\d{1,4}(?:-\\d{1,6}){1,3}|1\\d{2}|#\\d{4})$", "description": "半角数字とハイフン" },
                      "note": { "type": ["string", "null"] }
                    }
                  }
                },
                "hours": { "type": ["string", "null"], "description": "受付時間。\"unverified\" なら画面に「受付時間は公式ページで確かめてください」。電話番号が無いときは null" }
              }
            }
          }
        ]
      },
      "general_alternatives": {
        "description": "同じ用事ができる別の手段（一般論）",
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "link"],
          "properties": { "text": { "type": "string" }, "link": { "type": ["string", "null"], "description": "data/links.json の id" } }
        }
      },
      "not_official": {
        "description": "公式ではないと案内されているドメイン（偽サイトに注意の欄に出す）",
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "note"],
          "properties": { "domain": { "type": "string" }, "note": { "type": "string" } }
        }
      },
      "monitor": {
        "description": "自動観測（フェーズ2）の設定",
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "method", "enabled", "statuspage_api"],
        "properties": {
          "url": { "type": ["string", "null"] },
          "method": { "enum": ["HEAD", "GET"] },
          "enabled": { "type": "boolean" },
          "statuspage_api": { "type": ["string", "null"] }
        }
      },
      "phishing_guide": { "description": "会社が案内している偽メール・詐欺の見分け方のページ（無ければ null）。「偽サイトに注意」の欄に出す", "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/link" }] },
      "notes": { "type": "array", "items": { "type": "string" } },
      "verified_at": { "type": "string", "format": "date", "description": "180日を過ぎると画面に「要再確認」" },
      "verified_by": { "type": "string" }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "label", "verified", "note"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://", "description": "official_domains に一致すること" },
        "label": { "type": ["string", "null"] },
        "verified": { "type": "boolean", "description": "false: URL は公式の記載によるが、ページを開いて確かめられていない" },
        "note": { "type": ["string", "null"] }
      }
    }
  }
}
